<?xml version="1.0" encoding="UTF-8"?>
<web-app version="3.1" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd">
    
    <!-- 1. Login Routing -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.hospital.controller.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/LoginServlet</url-pattern>
    </servlet-mapping>

    <!-- 2. Logout Routing -->
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.hospital.controller.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/LogoutServlet</url-pattern>
    </servlet-mapping>

    <!-- 3. Register Routing -->
    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>com.hospital.controller.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/RegisterServlet</url-pattern>
    </servlet-mapping>

    <!-- 4. Patient Module Routing -->
    <servlet>
        <servlet-name>PatientController</servlet-name>
        <servlet-class>com.hospital.controller.PatientController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PatientController</servlet-name>
        <url-pattern>/PatientController</url-pattern>
    </servlet-mapping>

    <!-- 5. Doctor Module Routing -->
    <servlet>
        <servlet-name>DoctorController</servlet-name>
        <servlet-class>com.hospital.controller.DoctorController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DoctorController</servlet-name>
        <url-pattern>/DoctorController</url-pattern>
    </servlet-mapping>

    <!-- 6. Appointment Module Routing -->
    <servlet>
        <servlet-name>AppointmentController</servlet-name>
        <servlet-class>com.hospital.controller.AppointmentController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AppointmentController</servlet-name>
        <url-pattern>/AppointmentController</url-pattern>
    </servlet-mapping>

    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>
    
</web-app>